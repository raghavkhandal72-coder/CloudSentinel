# CloudSentinel - Environment Configuration Baseline

# ==========================================
# AWS Credentials (Optional if using ~/.aws)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default

# ==========================================
# Azure Credentials (Optional if using az login)
# ==========================================
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# ==========================================
# PostgreSQL Database (Dashboard & Storage)
# ==========================================
POSTGRES_USER=cloudsentinel
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=cloudsentinel
DATABASE_URL=postgresql://cloudsentinel:securepassword123@localhost:5432/cloudsentinel

# ==========================================
# REST API Server Configuration
# ==========================================
HOST=127.0.0.1
PORT=8000
